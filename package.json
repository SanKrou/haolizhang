{
  "name": "haolizhang",
  "version": "1.0.0",
  "description": "毫厘账 — Windows 桌面记账应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win"
  },
  "author": "毫厘账",
  "build": {
    "appId": "com.haolizhang.ledger",
    "productName": "毫厘账",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*.js",
      "renderer/**/*",
      "package.json",
      "!docs/**",
      "!tests/**",
      "!*.xlsx",
      "!.reasonix/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "毫厘账"
    }
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@11.10.0": true
  }
}
